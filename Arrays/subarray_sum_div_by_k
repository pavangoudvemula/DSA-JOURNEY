// LEETCODE : 974 PROBLEM  SUBARRAY SUM DIVISIBLE BY K

class Solution {
    public int subarraysDivByK(int[] nums, int k) {
        int[] prefix=new int[nums.length];
        prefix[0]=nums[0];
        for(int i=1;i<nums.length;i++){
            prefix[i]=prefix[i-1]+nums[i];
        }
        int count=0;
        HashMap<Integer,Integer> map=new HashMap<>();
        map.put(0, 1);
        for(int i=0;i<nums.length;i++){
            
           
                if(map.containsKey((prefix[i]%k+k)%k)){
                    count+=map.get((prefix[i]%k+k)%k);
                    map.put((prefix[i]%k+k)%k,map.get((prefix[i]%k+k)%k)+1);
                }
                else{
                    map.put((prefix[i]%k+k)%k,1);
                }
            }
        
        
        return count;
        
    }
}
