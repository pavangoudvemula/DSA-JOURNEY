// LEET CODE PROBLEM 560 SUBARRAY SUM EQUAL TO K
// APPROACH: PREFIX SUM AND HASH MAP
// TIME COMPLEXITY: O(n)
// SPACE COMPLEXITY: O(n)

class Solution {
    public int subarraySum(int[] nums, int k) {
        int [] prefix=new int[nums.length];
        int count=0;
        prefix[0]=nums[0];
        System.out.println(prefix[0]);
        for(int i=1;i<nums.length;i++){
            prefix[i]=prefix[i-1]+nums[i];
            System.out.println(prefix[i]);
        }

        HashMap<Integer,Integer> map=new HashMap<>();
        for(int i=0;i<nums.length;i++){
            System.out.println((prefix[i]==k));
            System.out.println((map.containsKey(k-prefix[i])));
            if(prefix[i]==k){
                count++;
               


            }
            else{
                if(map.containsKey(k-prefix[i])){
                    count++;
                }
                
                
            }
             map.put(prefix[i],1);

        }
       
        return count;
    }
}
